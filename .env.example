# Copy to .env for local development. Never commit .env.
DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase Postgres (Project > Connect > Session pooler). Leave unset to use SQLite locally.
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage (Project Settings > Storage > S3 access keys). Leave unset to store uploads in media/.
# SUPABASE_PROJECT_REF=<ref>
# SUPABASE_STORAGE_BUCKET=media
# SUPABASE_S3_REGION=ap-southeast-1
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=

# Email (Brevo). Without an API key, emails are printed to the console.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=you@example.com
